CNPJ_EMPRESA=
# Evolus (track "Evolus Business Agents on AMD"): event workspace key and application id. Never commit real values.
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_EXTRACTOR_ID=
EVOLUS_WORKFLOW_ID=
